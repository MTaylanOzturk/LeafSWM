From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: MahmutTaylanOzturk <ozturkmahmuttaylan@gmail.com>
Date: Sun, 24 May 2026 22:26:25 +0300
Subject: [PATCH] Increase ReadTimeoutHandler duration from 30 to 300 seconds
 for improved connection stability


diff --git a/net/minecraft/network/Connection.java b/net/minecraft/network/Connection.java
index 4e16552680f86cf1589f862cb38c0f43df344e6a..22d2df29655419f253cfaebec194215120a3f85e 100644
--- a/net/minecraft/network/Connection.java
+++ b/net/minecraft/network/Connection.java
@@ -709,7 +709,7 @@ public class Connection extends SimpleChannelInboundHandler<Packet<?>> {
                 } catch (ChannelException var3) {
                 }
 
-                ChannelPipeline channelPipeline = channel.pipeline().addLast("timeout", new ReadTimeoutHandler(30));
+                ChannelPipeline channelPipeline = channel.pipeline().addLast("timeout", new ReadTimeoutHandler(300));
                 Connection.configureSerialization(channelPipeline, PacketFlow.CLIENTBOUND, false, connection.bandwidthDebugMonitor);
                 connection.configurePacketHandler(channelPipeline);
             }
diff --git a/net/minecraft/server/network/ServerConnectionListener.java b/net/minecraft/server/network/ServerConnectionListener.java
index 33e1cdb00d648c992af03a976899253141314b27..00d686663e2b00145073e8d12d17cd99c6c11ee9 100644
--- a/net/minecraft/server/network/ServerConnectionListener.java
+++ b/net/minecraft/server/network/ServerConnectionListener.java
@@ -94,7 +94,7 @@ public class ServerConnectionListener {
                                     }
 
                                     if (!disableFlushConsolidation) channel.pipeline().addFirst(new io.netty.handler.flush.FlushConsolidationHandler()); // Paper - Optimize network
-                                    ChannelPipeline channelPipeline = channel.pipeline().addLast("timeout", new ReadTimeoutHandler(30));
+                                    ChannelPipeline channelPipeline = channel.pipeline().addLast("timeout", new ReadTimeoutHandler(300));
                                     if (ServerConnectionListener.this.server.repliesToStatus()) {
                                         channelPipeline.addLast("legacy_query", new LegacyQueryHandler(ServerConnectionListener.this.getServer()));
                                     }
